/** Rosie's cute, configurable phrases. */
object Persona {
    private fun cute(p: Prefs) = p.cuteExpressions && p.personality != "professional"

    fun opening(p: Prefs) = if (cute(p)) "I missed you too! Kucchu puuuchu!" else "Hello! How can I help?"
    fun welcomeBack(p: Prefs) = if (cute(p)) "You're back! I missed chatting with you!" else "Welcome back!"
    fun answerLead(p: Prefs) = if (cute(p)) "Kucchu puuuchu! Here's your answer..." else ""
    fun goodbye(p: Prefs) = if (cute(p)) "Byyy byyy! Take care! Kucchu puuuchu!" else "Goodbye! Take care."

    fun timeGreeting(p: Prefs, hour: Int = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)): String = when (hour) {
        in 5..11 -> if (cute(p)) "Good morning! Have a beautiful day. Kucchu puuuchu!" else "Good morning!"
        in 12..16 -> "Good afternoon! How is your day going?"
        in 17..20 -> "Good evening! How was your day?"
        else -> if (cute(p)) "Good night! Sweet dreams. Kucchu puuuchu!" else "Good night!"
    }

    /** Optional playful "I love you", at the user's configured frequency (0 = never). */
    fun maybeLove(p: Prefs): String {
        if (!cute(p)) return ""
        val chance = when (p.loveFrequency) { 1 -> 0.08; 2 -> 0.25; else -> 0.0 }
        return if (Random.nextDouble() < chance) " I love you!" else ""
    }
}


