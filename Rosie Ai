package com.rosie.ai.data

import com.google.firebase.auth.FirebaseAuth
import com.google.firebase.firestore.FirebaseFirestore
import com.google.firebase.firestore.Query
import kotlinx.coroutines.tasks.await

/**
 * Firebase Auth + Firestore. Everything is wrapped in runCatching so the app still works
 * (local commands, no cloud) until you add google-services.json.
 */
class CloudRepo {
    private fun auth() = FirebaseAuth.getInstance()
    private fun db() = FirebaseFirestore.getInstance()

    suspend fun ensureSignedIn(): String? = runCatching {
        auth().currentUser?.uid ?: auth().signInAnonymously().await().user?.uid
    }.getOrNull()

    suspend fun idToken(): String? = runCatching {
        ensureSignedIn()
        auth().currentUser?.getIdToken(false)?.await()?.token
    }.getOrNull()

    /** Called only after the user says "remember that ..." (explicit approval). */
    suspend fun addMemory(text: String): Boolean = runCatching {
        val uid = ensureSignedIn() ?: error("no user")
        db().collection("users").document(uid).collection("memories")
            .add(mapOf("text" to text, "ts" to System.currentTimeMillis())).await()
        true
    }.getOrDefault(false)

    suspend fun memories(): List<String> = runCatching {
        val uid = ensureSignedIn() ?: return@runCatching emptyList<String>()
        db().collection("users").document(uid).collection("memories")
            .orderBy("ts", Query.Direction.DESCENDING).limit(30).get().await()
            .documents.mapNotNull { it.getString("text") }
    }.getOrDefault(emptyList())

    suspend fun savePrefs(map: Map<String, Any>) {
        runCatching {
            val uid = ensureSignedIn() ?: return
