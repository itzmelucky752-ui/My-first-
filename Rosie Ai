        val kind = when (word) { "fan" -> "fan"; "plug", "switch" -> "plug"; else -> "light" }
        if (!smartHome.configured() || smartHome.entityFor(kind).isBlank())
            return Reply("Smart home isn't set up yet. Add your Home Assistant address, token and $kind device in Settings.")
        return if (smartHome.set(kind, on)) Reply(if (on) "Sure! Turning on the $kind." else "Done! Good night!".takeIf { kind == "light" } ?: "Done! The $kind is off.")
