package com.rosie.ai.device

import android.Manifest
import android.app.NotificationManager
import android.content.Context
import android.content.pm.PackageManager
import android.os.Build
import androidx.core.app.NotificationCompat
import androidx.core.content.ContextCompat
import androidx.work.*
import com.rosie.ai.RosieApp
import com.rosie.ai.data.Persona
import com.rosie.ai.data.Prefs
import java.util.Calendar
import java.util.concurrent.TimeUnit

/** One-shot reminder ("remind me to X in 10 minutes"). */
class ReminderWorker(ctx: Context, params: WorkerParameters) : Worker(ctx, params) {
    override fun doWork(): Result {
        val text = inputData.getString("text") ?: return Result.success()
        notify(applicationContext, "Reminder", text, (System.currentTimeMillis() % 100000).toInt())
        return Result.success()
    }
}

/** Optional periodic friendly message. Only scheduled if the user turns it on; quiet between 10pm and 8am. */
class GreetingWorker(ctx: Context, params: WorkerParameters) : Worker(ctx, params) {
    override fun doWork(): Result {
        val prefs = Prefs(applicationContext)
        val h = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
        if (!prefs.hourlyMessages || h < 8 || h >= 22) return Result.success()
        notify(applicationContext, "Rosie", Persona.timeGreeting(prefs, h), 4242)
        return Result.success()
    }
}

private fun notify(ctx: Context, title: String, text: String, id: Int) {
    if (Build.VERSION.SDK_INT >= 33 &&
        ContextCompat.checkSelfPermission(ctx, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
    ) return
    val n = NotificationCompat.Builder(ctx, RosieApp.CH_REMINDERS)
        .setSmallIcon(android.R.drawable.ic_popup_reminder)
        .setContentTitle(title).setContentText(text)
        .setStyle(NotificationCompat.BigTextStyle().bigText(text))
        .setAutoCancel(true).build()
    ctx.getSystemService(NotificationManager::class.java).notify(id, n)
}

object Scheduler {
    fun reminder(ctx: Context, text: String, delayMs: Long) {
        val req = OneTimeWorkRequestBuilder<ReminderWorker>()
            .setInitialDelay(delayMs, TimeUnit.MILLISECONDS)
            .setInputData(workDataOf("text" to text)).build()
        WorkManager.getInstance(ctx).enqueue(req)
    }

    fun applyGreetingSchedule(ctx: Context, prefs: Prefs) {
        val wm = WorkManager.getInstance(ctx)
        if (!prefs.hourlyMessages) { wm.cancelUniqueWork("greetings"); return }
        val req = PeriodicWorkRequestBuilder<GreetingWorker>(prefs.hourlyInterval.coerceAtLeast(1).toLong(), TimeUnit.HOURS).build()
        wm.enqueueUniquePeriodicWork("greetings", ExistingPeriodicWorkPolicy.UPDATE, req)
    }
}


