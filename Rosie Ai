    private fun callControl(what: String): Reply {
        if (Build.VERSION.SDK_INT < 28 && what != "answer") return Reply("Ending calls by voice needs Android 9 or newer.")
        if (!has(Manifest.permission.ANSWER_PHONE_CALLS)) return Reply("I need permission to manage phone calls.", needPermission = Manifest.permission.ANSWER_PHONE_CALLS)
        val tm = ctx.getSystemService(Context.TELECOM_SERVICE) as TelecomManager
        return try {
            when (what) {
                "answer" -> { tm.acceptRingingCall(); Reply("Answering your call.") }
                else -> { @Suppress("DEPRECATION") val ok = tm.endCall(); Reply(if (ok) (if (what == "reject") "Call rejected." else "Call ended.") else "There's no active call right now.") }
            }
        } catch (e: SecurityException) { Reply("Android didn't allow that call action.") }
    }

    private fun numberFor(name: String): Pair<String, String>? {
        val digits = name.replace(Regex("[\\s-]"), "")
        if (digits.matches(Regex("\\+?\\d{6,15}"))) return name to digits
        val c = ctx.contentResolver.query(
            ContactsContract.CommonDataKinds.Phone.CONTENT_URI,
            arrayOf(ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME, ContactsContract.CommonDataKinds.Phone.NUMBER),
            "${ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME} LIKE ?", arrayOf("%$name%"), null
        )
        c?.use { if (it.moveToFirst()) return it.getString(0) to it.getString(1) }
        return null
    }

    private fun callContact(name: String): Reply {
        val isNumber = name.replace(Regex("[\\s-]"), "").matches(Regex("\\+?\\d{6,15}"))
        if (!isNumber && !has(Manifest.permission.READ_CONTACTS)) return Reply("I need contacts permission to find $name.", needPermission = Manifest.permission.READ_CONTACTS)
        val (label, number) = numberFor(name) ?: return Reply("I couldn't find $name in your contacts.")
        return Reply("Call $label? Say yes to confirm.", confirm = {
            val uri = Uri.parse("tel:" + Uri.encode(number))
            val i = if (has(Manifest.permission.CALL_PHONE)) Intent(Intent.ACTION_CALL, uri) else Intent(Intent.ACTION_DIAL, uri)
            Reply(if (launch(i)) "Calling $label." else "I couldn't start the call.")
        })
    }

    private fun whatsapp(name: String, message: String): Reply {
        val isNumber = name.replace(Regex("[\\s-]"), "").matches(Regex("\\+?\\d{6,15}"))
        if (!isNumber && !has(Manifest.permission.READ_CONTACTS)) return Reply("I need contacts permission to find $name.", needPermission = Manifest.permission.READ_CONTACTS)
        val (label, number) = numberFor(name) ?: return Reply("I couldn't find $name in your contacts.")
        var digits = number.filter { it.isDigit() }
        if (digits.length == 10) digits = prefs.countryCode + digits
        return Reply("Open WhatsApp chat with $label${if (message.isNotBlank()) " with your message ready" else ""}? Say yes.", confirm = {
            val url = "https://wa.me/$digits" + if (message.isNotBlank()) "?text=" + URLEncoder.encode(message, "UTF-8") else ""
            val i = Intent(Intent.ACTION_VIEW, Uri.parse(url)).setPackage("com.whatsapp")
            val ok = launch(i) || launch(Intent(Intent.ACTION_VIEW, Uri.parse(url)))
            Reply(if (ok) "WhatsApp is open. Tap send when you're ready." else "I couldn't open WhatsApp.")
        })
