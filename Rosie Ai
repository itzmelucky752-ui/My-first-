        tts.onSpeakingChanged = { s -> status = if (s) Status.SPEAKING else if (status == Status.SPEAKING) Status.IDLE else status }
        // Conversation history persists locally (cleared by "Delete my data").
        store.all().takeLast(40).forEach { line ->
            val role = line.substringBefore('|'); val text = line.substringAfter('|')
            messages += Msg(role, text)
        }
        if (prefs.greetingsEnabled) {
            val away = System.currentTimeMillis() - prefs.lastOpenMillis
            val hi = when {
                prefs.lastOpenMillis == 0L -> Persona.timeGreeting(prefs)
                away > 6 * 3600_000L -> Persona.welcomeBack(prefs)
                else -> Persona.opening(prefs)
            }
            say(hi)
        }
        prefs.lastOpenMillis = System.currentTimeMillis()
    }

    private fun say(text: String, speak: Boolean = true) {
        messages += Msg("rosie", text)
        store.add("rosie|$text")
        if (speak) tts.speak(text)
    }

    fun startListening() {
        if (!prefs.micEnabled) { say("My microphone is turned off in Settings.", speak = false); return }
        tts.stop()
        status = Status.LISTENING; partial = ""
        speech.listen(prefs.sttLang,
            onPartial = { partial = it },
            onResult = { partial = ""; status = Status.IDLE; if (it.isNotBlank()) submit(it) },
            onError = { status = Status.IDLE; partial = "" })
    }

    fun stopListening() { speech.stop(); status = Status.IDLE; partial = "" }

    fun submit(text: String) {
        val clean = text.trim()
        if (clean.isEmpty()) return
        messages += Msg("user", clean)
        store.add("user|$clean")
        viewModelScope.launch { process(clean) }
    }

    private suspend fun process(text: String) {
        status = Status.THINKING
        val p = pending
        if (p != null) {
            pending = null
            if (Regex("\\b(yes|yeah|yep|haan|ha|sure|ok|okay|confirm)\\b").containsMatchIn(text.lowercase())) { show(p()); return }
            if (Regex("\\b(no|nope|nahi|cancel|stop)\\b").containsMatchIn(text.lowercase())) { status = Status.IDLE; say("Okay, cancelled."); return }
        }
        val att = attachment
        if (att != null) { attachment = null; answerWithAi(text, att); return }
        val r = router.handle(text)
        if (r.askAi) answerWithAi(text, null) else show(r, text)
    }

    private fun show(r: Reply, original: String = "") {
        status = Status.IDLE
        when {
            r.needPermission != null -> { retryText = original; say(r.text); permissionRequest = r.needPermission }
            r.confirm != null -> { pending = r.confirm; say(r.text) }
            else -> say(r.text + Persona.maybeLove(prefs))
        }
    }

    private suspend fun answerWithAi(text: String, att: Attachment?) {
        val mem = cloud.memories()
        val reply = ai.ask(messages.filter { it.role == "user" || it.role == "rosie" }.takeLast(14), mem, att)
        status = Status.IDLE
        val lead = Persona.answerLead(prefs)
        messages += Msg("rosie", reply)
        store.add("rosie|${reply.replace("\n", " ")}")
        tts.speak(if (lead.isNotEmpty()) "$lead $reply" else reply)
    }

    fun onPermissionResult(granted: Boolean) {
        permissionRequest = null
        val t = retryText; retryText = null
        if (granted && t != null) submit(t) else say("No problem, I won't do that without permission.", speak = false)
    }

    fun attach(uri: Uri) {
        viewModelScope.launch {
            val app = getApplication<Application>()
            val mime = app.contentResolver.getType(uri) ?: "application/octet-stream"
            if (!(mime.startsWith("image/") || mime == "application/pdf")) { say("I can read images and PDF files.", speak = false); return@launch }
            val bytes = withContext(Dispatchers.IO) { app.contentResolver.openInputStream(uri)?.use { it.readBytes() } }
            if (bytes == null || bytes.size > 8_000_000) { say("That file is too big (limit 8 MB).", speak = false); return@launch }
            attachment = Attachment(mime, Base64.encodeToString(bytes, Base64.NO_WRAP), uri.lastPathSegment ?: "file")
        }
    }

    fun syncPrefs() = viewModelScope.launch {
        cloud.savePrefs(mapOf("language" to prefs.language, "rate" to prefs.speechRate, "pitch" to prefs.pitch, "personality" to prefs.personality))
    }

    fun deleteMyData(done: (Boolean) -> Unit) = viewModelScope.launch {
        val ok = cloud.deleteEverything()
        listOf("notes", "tasks", "history").forEach { TextStore(getApplication(), it).clear() }
        prefs.clearAll(); messages.clear()
        done(ok)
    }

    override fun onCleared() { speech.stop(); tts.shutdown() }
}


