package com.rosie.ai.device

import com.rosie.ai.data.Prefs
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody
import org.json.JSONObject

/**
 * Smart-home control through a Home Assistant server you run (REST API + long-lived token).
 * Home Assistant bridges to lights, plugs, fans and most IoT brands. No hardware is controlled without it.
 */
class SmartHome(private val prefs: Prefs) {
    private val http = OkHttpClient()

    fun configured() = prefs.haUrl.isNotBlank() && prefs.haToken.isNotBlank()

    fun entityFor(kind: String): String = when (kind) {
        "light" -> prefs.haLight
        "fan" -> prefs.haFan
        else -> prefs.haPlug
    }

    suspend fun set(kind: String, on: Boolean): Boolean = withContext(Dispatchers.IO) {
        val entity = entityFor(kind)
        if (!configured() || entity.isBlank()) return@withContext false
        val domain = entity.substringBefore('.')
        val svc = if (on) "turn_on" else "turn_off"
        val req = Request.Builder()
            .url("${prefs.haUrl.trimEnd('/')}/api/services/$domain/$svc")
            .header("Authorization", "Bearer ${prefs.haToken}")
            .post(JSONObject().put("entity_id", entity).toString().toRequestBody("application/json".toMediaType()))
            .build()
        runCatching { http.newCall(req).execute().use { it.isSuccessful } }.getOrDefault(false)
    }
}


