package com.rosie.ai.data

import android.content.Context
import java.io.File

/** Tiny local line store used for personal notes and tasks. Stays on the device. */
class TextStore(ctx: Context, name: String) {
    private val file = File(ctx.filesDir, "$name.txt")
    fun all(): List<String> = if (file.exists()) file.readLines().filter { it.isNotBlank() } else emptyList()
    fun add(line: String) { file.appendText(line.replace("\n", " ") + "\n") }
    fun remove(index: Int): String? {
        val l = all().toMutableList()
        if (index !in l.indices) return null
        val gone = l.removeAt(index)
        file.writeText(l.joinToString("\n") + if (l.isEmpty()) "" else "\n")
        return gone
    }
    fun clear() { file.delete() }
}


