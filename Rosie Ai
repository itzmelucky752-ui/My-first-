package com.rosie.ai.data

import com.rosie.ai.BuildConfig
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody
import org.json.JSONArray
import org.json.JSONObject
import java.util.concurrent.TimeUnit

data class Msg(val role: String, val text: String, val time: Long = System.currentTimeMillis())
data class Attachment(val mime: String, val base64: String, val name: String)

/** Talks ONLY to your backend. The AI provider key never ships in the APK. */
class AiClient(private val prefs: Prefs, private val cloud: CloudRepo) {
    private val http = OkHttpClient.Builder()
        .callTimeout(60, TimeUnit.SECONDS).build()

    suspend fun ask(history: List<Msg>, memories: List<String>, attachment: Attachment? = null): String =
        withContext(Dispatchers.IO) {
            val token = cloud.idToken()
                ?: return@withContext "I can't reach my brain yet. Please finish the Firebase setup (see README), then try again."
            val msgs = JSONArray()
            history.takeLast(14).forEach {
                msgs.put(JSONObject().put("role", if (it.role == "user") "user" else "assistant").put("content", it.text))
            }
            val body = JSONObject()
                .put("messages", msgs)
                .put("language", prefs.language)
                .put("personality", prefs.personality)
                .put("memories", JSONArray(memories))
            attachment?.let {
                body.put("attachment", JSONObject().put("mime", it.mime).put("data", it.base64).put("name", it.name))
            }
            val req = Request.Builder()
                .url(BuildConfig.BACKEND_URL.trimEnd('/') + "/chat")
                .header("Authorization", "Bearer $token")
                .post(body.toString().toRequestBody("application/json".toMediaType()))
                .build()
            try {
                http.newCall(req).execute().use { r ->
                    val txt = r.body?.string().orEmpty()
                    when {
                        r.code == 429 -> "You've reached today's free limit. Premium gives you much more!"
                        !r.isSuccessful -> "My brain had a hiccup (error ${r.code}). Please try again."
                        else -> JSONObject(txt).optString("reply", "Hmm, I didn't get an answer.")
                    }
                }
            } catch (e: Exception) {
                "I couldn't connect to the internet. Basic phone commands still work offline!"
            }
        }
}


