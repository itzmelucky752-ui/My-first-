/**
 * Result of handling a spoken/typed command.
 *  - askAi: nothing matched, send to the AI brain.
 *  - needPermission: UI must request this runtime permission, then re-run the same command.
 *  - confirm: important action; run only after the user says yes.
 */
data class Reply(
    val text: String = "",
    val askAi: Boolean = false,
    val needPermission: String? = null,
    val confirm: (suspend () -> Reply)? = null
)

class CommandRouter(
    private val ctx: Context,
    private val prefs: Prefs,
    private val cloud: CloudRepo
) {
    private val pm = ctx.packageManager
    private val smartHome = SmartHome(prefs)
    private val notes = TextStore(ctx, "notes")
    private val tasks = TextStore(ctx, "tasks")

    private val knownApps = mapOf(
        "whatsapp" to "com.whatsapp", "instagram" to "com.instagram.android",
        "snapchat" to "com.snapchat.android", "youtube" to "com.google.android.youtube",
        "spotify" to "com.spotify.music", "maps" to "com.google.android.apps.maps",
        "chrome" to "com.android.chrome", "gmail" to "com.google.android.gm"
    )
    private val onRx = Regex("\\b(on|chalu|jalao|start|enable)\\b")
    private val offRx = Regex("\\b(off|band|bujhao|stop|disable)\\b")
    private fun wantsOn(t: String): Boolean? = when {
        offRx.containsMatchIn(t) -> false
        onRx.containsMatchIn(t) -> true
        else -> null
    }

    private fun has(p: String) = ContextCompat.checkSelfPermission(ctx, p) == PackageManager.PERMISSION_GRANTED
    private fun launch(i: Intent): Boolean = try {
        ctx.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)); true
    } catch (e: Exception) { false }

    suspend fun handle(raw: String): Reply {
        val t = raw.trim().lowercase()
            .replace(Regex("^(hey|hi|ok)\\s+(rosie|rosy)[ ,.]*"), "")
            .replace(Regex("^rosie[ ,.]+"), "")
            .trim(' ', ',', '.', '?', '!')
        if (t.isEmpty()) return Reply("Yes? I'm listening!")
        var m: MatchResult?

        // ---- Greetings / goodbye / mic ----
        if (Regex("^(good morning|good afternoon|good evening|namaste|hello|hi)$").matches(t)) return Reply(Persona.timeGreeting(prefs) + Persona.maybeLove(prefs))
        if (Regex("^(bye|goodbye|good night|byy+e*|alvida|chalo bye)$").matches(t)) return Reply(Persona.goodbye(prefs))
        if (Regex("(stop listening|mic off|microphone off|mute yourself)").containsMatchIn(t)) {
            prefs.micEnabled = false; prefs.wakeEnabled = false
            ctx.stopService(Intent(ctx, WakeWordService::class.java))
            return Reply("Okay, my microphone is off. You can turn it back on in Settings.")
        }

        // ---- Calls: control ----
        if (Regex("(answer|pick up|utha\\w*|receive).*call").containsMatchIn(t)) return callControl("answer")
        if (Regex("(reject|decline|cut).*call").containsMatchIn(t)) return callControl("reject")
        if (Regex("(end|hang ?up|disconnect|band kar).*call").containsMatchIn(t)) return callControl("end")

        // ---- Phone calls / WhatsApp ----
        m = Regex("^(?:call|phone|dial)\\s+(.+)$").find(t) ?: Regex("^(.+?)\\s+ko\\s+call\\s*(?:karo|kar do|lagao)?$").find(t)
        if (m != null) return callContact(m.groupValues[1].trim())
        m = Regex("^(?:send|bhej\\w*)\\s+(?:a\\s+)?whatsapp(?:\\s+message)?\\s+to\\s+(.+?)(?:\\s+(?:saying|that|message)\\s+(.+))?$").find(t)
        if (m != null) return whatsapp(m.groupValues[1].trim(), m.groupValues[2].trim())

        // ---- Flashlight ----
        if (Regex("(torch|flashlight|flash light)").containsMatchIn(t)) return torch(wantsOn(t))

        // ---- Volume / brightness ----
        val audio = ctx.getSystemService(Context.AUDIO_SERVICE) as AudioManager
        m = Regex("volume.*?(\\d{1,3})\\s*(?:%|percent)?").find(t)
        if (m != null && Regex("(set|to|kar)").containsMatchIn(t)) {
            val pct = m.groupValues[1].toInt().coerceIn(0, 100)
            val max = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
            audio.setStreamVolume(AudioManager.STREAM_MUSIC, max * pct / 100, AudioManager.FLAG_SHOW_UI)
            return Reply("Volume set to $pct%.")
        }
        if (Regex("(increase|raise|louder|badha\\w*|zyada).*volume|volume.*(up|increase|badha\\w*|zyada)|^volume up").containsMatchIn(t)) {
            audio.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_RAISE, AudioManager.FLAG_SHOW_UI)
            return Reply("Volume up!")
        }
        if (Regex("(decrease|lower|reduce|kam|ghata\\w*).*volume|volume.*(down|decrease|kam|ghata\\w*)|^volume down").containsMatchIn(t)) {
            audio.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_LOWER, AudioManager.FLAG_SHOW_UI)
            return Reply("Volume down.")
        }
        m = Regex("brightness.*?(\\d{1,3})").find(t)
        if (m != null) return brightness(m.groupValues[1].toInt().coerceIn(0, 100))

        // ---- Radios / DND ----
        if (t.contains("bluetooth")) return bluetooth(wantsOn(t))
        if (Regex("wi-?fi|wifi").containsMatchIn(t)) return wifi(wantsOn(t))
        if (Regex("do not disturb|dnd|silent mode").containsMatchIn(t)) return dnd(wantsOn(t) ?: true)

        // ---- Alarm / reminder ----
        if (t.contains("alarm")) return alarm(t)
        m = Regex("remind me (?:to )?(.+?)\\s+(?:in|after)\\s+(\\d+)\\s*(second|sec|minute|min|hour|hr)s?").find(t)
        if (m != null) return reminder(m.groupValues[1], m.groupValues[2].toLong(), m.groupValues[3])
        if (t.contains("reminder")) return Reply("Sure! Tell me like this: \"remind me to drink water in 10 minutes\".")

        // ---- Notifications ----
        if (Regex("read.*notification|notification.*read|meri notification").containsMatchIn(t)) return readNotifications()

        // ---- Smart home ----
        m = Regex("\\b(light|lamp|bulb|fan|plug|switch)\\b").find(t)
        if (m != null && wantsOn(t) != null) return smart(m.groupValues[1], wantsOn(t)!!)

        // ---- Device info ----
        if (Regex("battery").containsMatchIn(t)) {
            val bm = ctx.getSystemService(Context.BATTERY_SERVICE) as BatteryManager
            return Reply("Your battery is at ${bm.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)}%.")
        }
        if (Regex("storage|free space").containsMatchIn(t)) {
            val s = StatFs(Environment.getDataDirectory().path)
            val free = s.availableBytes / 1_073_741_824.0
            val total = s.totalBytes / 1_073_741_824.0
            return Reply("You have %.1f GB free out of %.0f GB.".format(free, total))
        }

        // ---- Schedule (calendar) ----
        if (Regex("(my schedule|calendar|aaj ka schedule|what'?s on today|meetings today)").containsMatchIn(t)) return schedule()

        // ---- Notes / tasks / memory ----
        m = Regex("^(?:take a note|note down|create a note|make a note|note)\\s*(?:that|:)?\\s*(.+)$").find(t)
        if (m != null) { notes.add(m.groupValues[1]); return Reply("Saved your note!") }
        if (Regex("(read|show|meri).*notes?").containsMatchIn(t)) {
            val l = notes.all()
            return Reply(if (l.isEmpty()) "You have no notes yet." else "Your notes: " + l.takeLast(5).joinToString(". "))
        }
        m = Regex("^add (?:a )?(?:task|to-?do)\\s*(?:to|:)?\\s*(.+)$").find(t)
        if (m != null) { tasks.add(m.groupValues[1]); return Reply("Added to your tasks!") }
        if (Regex("(show|read|my|meri).*(tasks|to-?do)").containsMatchIn(t)) {
            val l = tasks.all()
            return Reply(if (l.isEmpty()) "No tasks. Enjoy your free time!" else l.mapIndexed { i, s -> "${i + 1}. $s" }.joinToString(". "))
        }
        m = Regex("(?:complete|finish|done|remove) task (\\d+)").find(t)
        if (m != null) {
            val gone = tasks.remove(m.groupValues[1].toInt() - 1)
            return Reply(if (gone != null) "Done! Marked \"$gone\" complete." else "I couldn't find that task number.")
        }
        m = Regex("^remember (?:that )?(.+)$").find(t)
        if (m != null) {
            return if (cloud.addMemory(m.groupValues[1])) Reply("Got it, I'll remember that.")
            else Reply("I couldn't save that to the cloud yet. Please finish the Firebase setup.")
        }

        // ---- Sharing ----
        m = Regex("^share\\s+(.+)$").find(t)
        if (m != null) {
            val send = Intent(Intent.ACTION_SEND).apply { type = "text/plain"; putExtra(Intent.EXTRA_TEXT, m.groupValues[1]) }
            launch(Intent.createChooser(send, "Share via"))
            return Reply("Opening the share sheet.")
        }

        // ---- YouTube / music / navigation / websites ----
        m = Regex("(?:search|find|play)\\s+(.+?)\\s+on\\s+youtube").find(t) ?: Regex("^youtube\\s+(?:search|par)\\s+(.+)$").find(t)
        if (m != null) return youtube(m.groupValues[1])
        if (Regex("^(play|open|start) (some )?(music|songs?|gaane)").containsMatchIn(t)) {
            val ok = launch(Intent.makeMainSelectorActivity(Intent.ACTION_MAIN, Intent.CATEGORY_APP_MUSIC))
            return Reply(if (ok) "Opening your music app." else "I couldn't find a music app on this phone.")
        }
        m = Regex("^(?:navigate|directions|take me|route)\\s+(?:to\\s+)?(.+)$").find(t)
        if (m != null) {
            val q = URLEncoder.encode(m.groupValues[1], "UTF-8")
            val ok = launch(Intent(Intent.ACTION_VIEW, Uri.parse("google.navigation:q=$q"))) ||
                launch(Intent(Intent.ACTION_VIEW, Uri.parse("geo:0,0?q=$q")))
            return Reply(if (ok) "Starting navigation to ${m.groupValues[1]}." else "I couldn't find a maps app.")
        }
        m = Regex("^(?:open|go to|visit)\\s+((?:https?://)?[\\w-]+(?:\\.[\\w-]+)*\\.[a-z]{2,}(?:/\\S*)?)$").find(t)
        if (m != null) {
            val u = m.groupValues[1].let { if (it.startsWith("http")) it else "https://$it" }
            return Reply(if (launch(Intent(Intent.ACTION_VIEW, Uri.parse(u)))) "Opening $u." else "I couldn't open that website.")
        }

        // ---- Settings / camera / gallery / apps ----
        if (Regex("^(open|launch|kholo)?\\s*(phone )?settings\\s*(kholo|open)?$").matches(t))
            return Reply(if (launch(Intent(Settings.ACTION_SETTINGS))) "Opening Settings." else "I couldn't open Settings.")
        if (Regex("^(open|launch)?\\s*camera\\s*(kholo|open)?$").matches(t))
            return Reply(if (launch(Intent(MediaStore.INTENT_ACTION_STILL_IMAGE_CAMERA))) "Opening the camera." else "No camera app found.")
        if (Regex("^(open|launch)?\\s*(gallery|photos)\\s*(kholo|open)?$").matches(t)) {
            val ok = launch(Intent.makeMainSelectorActivity(Intent.ACTION_MAIN, Intent.CATEGORY_APP_GALLERY)) || openAppByLabel("gallery") || openAppByLabel("photos")
            return Reply(if (ok) "Opening your gallery." else "I couldn't find a gallery app.")
        }
        m = Regex("^(?:open|launch|start)\\s+(.+)$").find(t) ?: Regex("^(.+?)\\s+(?:kholo|khol do|open karo)$").find(t)
        if (m != null) return openApp(m.groupValues[1].trim())

        return Reply(askAi = true)
    }

    // ---------- Actions ----------

    private fun openAppByLabel(name: String): Boolean {
        val main = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
        val hit = pm.queryIntentActivities(main, 0).firstOrNull {
            it.loadLabel(pm).toString().lowercase().contains(name)
        } ?: return false
        return launch(Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
            .setClassName(hit.activityInfo.packageName, hit.activityInfo.name))
    }

    private fun openApp(name: String): Reply {
        val pkg = knownApps[name.replace(" ", "")]
        val intent = pkg?.let { pm.getLaunchIntentForPackage(it) }
        if (intent != null && launch(intent)) return Reply("Opening $name.")
        if (openAppByLabel(name)) return Reply("Opening $name.")
        return Reply("I couldn't find an app called $name installed on this phone.")
    }

    private fun torch(on: Boolean?): Reply {
        if (!pm.hasSystemFeature(PackageManager.FEATURE_CAMERA_FLASH)) return Reply("Sorry, this phone doesn't have a flashlight.")
        val cm = ctx.getSystemService(Context.CAMERA_SERVICE) as CameraManager
        val id = cm.cameraIdList.firstOrNull { cm.getCameraCharacteristics(it).get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true }
            ?: return Reply("I couldn't access the flashlight.")
        val target = on ?: !torchState
        return try {
            cm.setTorchMode(id, target); torchState = target
            Reply(if (target) "Flashlight on!" else "Flashlight off.")
        } catch (e: Exception) { Reply("I couldn't change the flashlight. Another app may be using the camera.") }
    }

    private fun brightness(pct: Int): Reply {
        if (!Settings.System.canWrite(ctx)) {
            launch(Intent(Settings.ACTION_MANAGE_WRITE_SETTINGS, Uri.parse("package:${ctx.packageName}")))
            return Reply("I need the 'Modify system settings' permission for brightness. Please allow it, then ask me again.")
        }
        Settings.System.putInt(ctx.contentResolver, Settings.System.SCREEN_BRIGHTNESS_MODE, Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL)
        Settings.System.putInt(ctx.contentResolver, Settings.System.SCREEN_BRIGHTNESS, 255 * pct / 100)
        return Reply("Brightness set to $pct%.")
    }

    @Suppress("DEPRECATION")
    private fun bluetooth(on: Boolean?): Reply {
        val adapter = (ctx.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager).adapter
            ?: return Reply("This phone doesn't have Bluetooth.")
        if (Build.VERSION.SDK_INT >= 33 || on == null) {
            launch(Intent(Settings.ACTION_BLUETOOTH_SETTINGS))
            return Reply("Android doesn't let apps switch Bluetooth on or off directly, so I've opened the Bluetooth settings for you.")
        }
        if (Build.VERSION.SDK_INT >= 31 && !has(Manifest.permission.BLUETOOTH_CONNECT)) return Reply("I need Bluetooth permission.", needPermission = Manifest.permission.BLUETOOTH_CONNECT)
        return try {
            if (on) adapter.enable() else adapter.disable()
            Reply(if (on) "Bluetooth on." else "Bluetooth off.")
        } catch (e: SecurityException) { Reply("I couldn't change Bluetooth.") }
    }

    @Suppress("DEPRECATION")
    private fun wifi(on: Boolean?): Reply {
        val wm = ctx.applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager
        if (Build.VERSION.SDK_INT >= 29 || on == null) {
            launch(Intent(Settings.Panel.ACTION_WIFI))
            return Reply("Android 10 and newer don't let apps toggle Wi-Fi directly, so I've opened the Wi-Fi panel for you.")
        }
        wm.isWifiEnabled = on
        return Reply(if (on) "Wi-Fi on." else "Wi-Fi off.")
    }

    private fun dnd(on: Boolean): Reply {
        val nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (!nm.isNotificationPolicyAccessGranted) {
            launch(Intent(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS))
            return Reply("I need Do Not Disturb access. Please allow ROSIE AI there, then ask me again.")
        }
        nm.setInterruptionFilter(if (on) NotificationManager.INTERRUPTION_FILTER_NONE else NotificationManager.INTERRUPTION_FILTER_ALL)
        return Reply(if (on) "Do Not Disturb is on." else "Do Not Disturb is off.")
    }

    private fun alarm(t: String): Reply {
        val m = Regex("(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm|a\\.m\\.|p\\.m\\.)?").find(t.substringAfter("alarm"))
        val i = Intent(AlarmClock.ACTION_SET_ALARM)
        if (m != null && (m.groupValues[2].isNotEmpty() || m.groupValues[3].isNotEmpty() || Regex("(for|at|baje)").containsMatchIn(t))) {
            var h = m.groupValues[1].toInt()
            val min = m.groupValues[2].ifEmpty { "0" }.toInt()
            val ap = m.groupValues[3].replace(".", "")
            if (ap == "pm" && h < 12) h += 12
            if (ap == "am" && h == 12) h = 0
            if (h !in 0..23 || min !in 0..59) return Reply("That doesn't look like a valid time.")
            i.putExtra(AlarmClock.EXTRA_HOUR, h).putExtra(AlarmClock.EXTRA_MINUTES, min).putExtra(AlarmClock.EXTRA_SKIP_UI, true)
            return Reply(if (launch(i)) "Alarm set for %02d:%02d.".format(h, min) else "I couldn't open your clock app.")
        }
        return Reply(if (launch(i)) "Opening the alarm screen. Pick your time!" else "I couldn't open your clock app.")
    }

    private fun reminder(what: String, n: Long, unit: String): Reply {
        if (Build.VERSION.SDK_INT >= 33 && !has(Manifest.permission.POST_NOTIFICATIONS))
            return Reply("I need notification permission to remind you.", needPermission = Manifest.permission.POST_NOTIFICATIONS)
        val ms = when { unit.startsWith("sec") -> n * 1000; unit.startsWith("m") -> n * 60_000; else -> n * 3_600_000 }
        Scheduler.reminder(ctx, what, ms)
        return Reply("Okay! I'll remind you to $what in $n $unit${if (n > 1) "s" else ""}.")
    }

    private fun readNotifications(): Reply {
        if (!NotificationManagerCompat.getEnabledListenerPackages(ctx).contains(ctx.packageName)) {
            launch(Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS))
            return Reply("To read notifications I need Notification Access. Please enable ROSIE AI there, then ask me again.")
        }
        val l = RosieNotificationListener.latest(5)
        return Reply(if (l.isEmpty()) "No new notifications since I started watching." else "Here are your latest notifications. " + l.joinToString(". "))
    }

    private fun schedule(): Reply {
        if (!has(Manifest.permission.READ_CALENDAR)) return Reply("I need calendar permission to read your schedule.", needPermission = Manifest.permission.READ_CALENDAR)
        val start = Calendar.getInstance().apply { set(Calendar.HOUR_OF_DAY, 0); set(Calendar.MINUTE, 0) }.timeInMillis
        val end = start + 86_400_000
        val uri = CalendarContract.Instances.CONTENT_URI.buildUpon().also {
            ContentUris.appendId(it, start); ContentUris.appendId(it, end)
        }.build()
        val items = mutableListOf<String>()
        ctx.contentResolver.query(uri, arrayOf(CalendarContract.Instances.TITLE, CalendarContract.Instances.BEGIN), null, null, "${CalendarContract.Instances.BEGIN} ASC")?.use { c ->
            while (c.moveToNext()) {
                val cal = Calendar.getInstance().apply { timeInMillis = c.getLong(1) }
                items += "%02d:%02d %s".format(cal.get(Calendar.HOUR_OF_DAY), cal.get(Calendar.MINUTE), c.getString(0))
